# Copy to .env (chmod 600) and adjust. Relative paths are relative to this folder.

# API key, required on every API route (incl. /v1/models); only /health and the web UI page are open.
# Generate one with:  openssl rand -hex 32
# Empty = no authentication (only acceptable when the port is reachable by you alone).
LLAMA_API_KEY=

# Model files, mounted read-only at /models in the container.
MODELS_DIR=../../models
BONSAI_GGUF_FILE=Ternary-Bonsai-2-27B-Uncensored-Heretic-GGUF/Ternary-Bonsai-2-27B-Uncensored-Heretic-PQ2_0.gguf
BONSAI_MMPROJ_FILE=Ternary-Bonsai-2-27B-Uncensored-Heretic-GGUF/mmproj-Q8_0.gguf
BONSAI_ALIAS=bonsai2-27b

# Launcher settings (meaning as in environment_variables.md).
# 128000 + KV4 + mmproj on the GPU uses ~10.4 GB of a 12 GB RTX 3080 (README.md).
BONSAI_CTX=128000
BONSAI_KV4=1
BONSAI_NGL=99
BONSAI_IMAGE_MAX_TOKENS=0
BONSAI_MMPROJ_CPU=0
# Trailing llama-server flags.
BONSAI_EXTRA_ARGS=-np 1 --ctx-checkpoints 4

# Published proxy port. Keep the bind on loopback; reach it with an SSH tunnel
# or a tunnel daemon running on the same host.
BONSAI_BIND=127.0.0.1
BONSAI_PUBLIC_PORT=8080
